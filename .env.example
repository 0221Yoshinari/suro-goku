SITE7_EMAIL=
SITE7_PASSWORD=
SITE7_INPUT_JSON=

# 店舗は config/halls.json で管理（追加・削除はそちらの enabled / 配列を編集）
# 一時的に上書きする場合のみ:
# SITE7_HALL_NAMES=１２３博多店,パーラーゾーン姪浜,玉屋∞本店,プラザ３,プラザ博多

# 1店舗ごとの待機（秒）。通常の定期取得用。東京マルハン巡回とは別。
SCRAPER_PAUSE_MIN_SEC=2.0
SCRAPER_PAUSE_MAX_SEC=3.0

# 東京マルハン10店舗のサイトセブン巡回（python -m src.scraper.site7_circuit）
# ログインは上の SITE7_EMAIL / SITE7_PASSWORD。値はリポジトリに書かない。
# 店舗間隔の既定は 360〜720 秒。CAPTCHA と利用停止で巡回全体が止まり、
# data/site7/circuit_halt.json ができる。再開は --clear-halt。
# SITE7_CIRCUIT_GAP_MIN_SEC=360
# SITE7_CIRCUIT_GAP_MAX_SEC=720
# 同時に進める店舗数。プロキシで出口を分けるときは 24。1 だと全国巡回が直列になる。
SCRAPER_MAX_WORKERS=24

# ログインセッション（Cookie）の保存先。2回目以降は再ログインしない
# SITE7_STORAGE_STATE=data/site7/.auth/storage_state.json
# SITE7_FORCE_LOGIN=0
# SCRAPER_HEADLESS=1
# CAPTCHA 手動解除の待機秒数（0 なら即失敗）。デバッグ時は 60 など
# SITE7_CAPTCHA_WAIT_SEC=0
# テラモバ2の Turnstile を CapSolver で自動更新する
# CAPSOLVER_API_KEY=
# 古い hallcode URL は使わず、マイホール名で開く（必要なときだけ 1）
# SITE7_USE_HALL_URL=0

# 定期巡回（python3 -m src.scheduler / launchd）
# SCHEDULE_INTERVAL_MIN=30
# SCHEDULE_START=10:50
# SCHEDULE_END=23:00

# レジデンシャルプロキシ（Bright Data / Smartproxy 等）
# 未設定なら直接接続。HOST+PORT か SERVER のどちらかで有効になる。
# 複数本を回すときは config/proxy_config.json の enabled と endpoints を使う。
# 環境変数があるときは、そちらの1本が JSON の一覧より優先される。
# SCRAPER_PROXY_PROTOCOL=http
# SCRAPER_PROXY_HOST=
# SCRAPER_PROXY_PORT=
# SCRAPER_PROXY_USER=
# SCRAPER_PROXY_PASS=
# まとめて書く場合:
# SCRAPER_PROXY_SERVER=http://host:port

# マスターパネル（/master-panel-x7k3q9）は閲覧パスワードに加えてこのトークンが必要。
# 契約・無料体験の一覧は /master-panel-x7k3q9/contracts
# 未設定のあいだは管理APIを拒否する。値は画面や通知に出さない。
# MASTER_PANEL_TOKEN=
# MASTER_PANEL_SESSION_HOURS=12

# API仕様（/docs /redoc /openapi.json）。
# 未設定のとき、RENDER=true または ENVIRONMENT=production では出さない。ローカルは出す。
# DASHBOARD_API_DOCS=0
# DASHBOARD_API_DOCS=1

# ダッシュボードの閲覧パスワード。未設定・空のときは 2026
# ログイン後は DASHBOARD_SESSION_DAYS 日間、再入力なしで開ける
# DASHBOARD_PASSWORD=2026
# DASHBOARD_SESSION_DAYS=7
# Cookie署名用。未設定なら閲覧パスワードから派生する
# DASHBOARD_SESSION_SECRET=

# Render 上ではトンネルを使わない。待受ポートは Render が渡す PORT。
# TUNNEL_ENABLED=0
# X_MONITOR_DISABLE=1
# 発行された https://サービス名.onrender.com を、決済後の戻り先にする。
# DASHBOARD_URL=https://サービス名.onrender.com

# ダッシュボードの外部公開（既定で cloudflared のクイックトンネル）
# 起動時と定期巡回の開始時に HTTPS URL を発行し、Discord へリンクを送る
# TUNNEL_ENABLED=1
# TUNNEL_PROVIDER=cloudflared
# 固定の公開URLがあるときだけ設定（未設定ならトンネルURLを使う）
# DASHBOARD_URL=
# ngrok を使う場合: TUNNEL_PROVIDER=ngrok と NGROK_AUTHTOKEN=
# NGROK_AUTHTOKEN=

# LPの申し込みボタンは公式LINEだけを開く。未設定でもこのURLを使う。
LINE_OFFICIAL_URL=https://lin.ee/7XxLBBy
# 公開URL。未設定なら開いているホスト名を使う。
# DASHBOARD_URL=https://example.com
# 1=ライセンスキーだけを受け付け、運営用パスワードでは入れなくする。
# MEMBER_DISABLE_SHARED_PASSWORD=
# 1 にするとログインなしでツールを開く（確認用）。未設定なら課金中の会員だけ。
# DASHBOARD_OPEN=0
# コピーされたCookieを拒むあいだ（秒）。既定 1200。
# 別端末でログインしたときは、古いセッションをすぐに無効にする。
# MEMBER_SESSION_IDLE_SEC=1200
# 同じセッションのまま、別のIPから同時に開くのを拒む秒数。既定 120。
# MEMBER_CONCURRENT_WINDOW_SEC=120
# 更新Webhookが遅れても、課金中の利用者をすぐ切らない猶予（秒）。体験終了には使わない。
# MEMBER_PERIOD_GRACE_SEC=7200

# 会員台帳。未設定なら data/members.json。
# postgresql://user:pass@host:5432/surogoku または sqlite:///data/members.sqlite
# DATABASE_URL=
# PostgreSQL に接続できないときの sqlite ファイル。未設定なら data/members.sqlite
# MEMBER_SQLITE_PATH=
# 取得できたホールの集計も DATABASE_URL へ上書きする。空なら判定JSONだけ。
# PostgreSQL に接続できないときは data/hall_snapshots.sqlite
# HALL_SQLITE_PATH=

# LINE 決済Webhook（uvicorn main:app）。値は .env だけに置く。
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# SQUARE_APPLICATION_ID=
# SQUARE_ACCESS_TOKEN=
# sandbox はテストカードだけ。本番の Visa / Mastercard は production と本番の認証情報が必要。
# SQUARE_ENVIRONMENT=production
# カード登録ページの公開URL。未設定なら Render の RENDER_EXTERNAL_URL を使う。
# PUBLIC_BASE_URL=https://suro-goku-billing.onrender.com
# 未設定なら Square のロケーションとカタログから探す。
# SQUARE_LOCATION_ID=
# SQUARE_PLAN_VARIATION_ID=
# Square の Webhook 署名キー。通知URLと本文を HMAC-SHA256 して /square-webhook を検証する。
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# Square に登録した通知URL。末尾のスラッシュまで署名対象と一致させる。
# SQUARE_WEBHOOK_NOTIFICATION_URL=https://example.com/square-webhook
# LINE / Square の会員台帳。DATABASE_URL が Postgres のときは請求とツールがそれを共有する。
# Postgres でないときだけ SQUARE_MEMBER_DB、それも無ければ data/square_members.sqlite。
# SQUARE_MEMBER_DB=
# リッチメニューのツール入口。LINE Login チャネルの ID と、そのチャネルで作った LIFF ID。
# どちらかを入れると、無料体験中（trialing）と有料会員（active）以外はツールを開けなくなる。
# LINE_ACCESS_GUARD=1
# LINE_LIFF_ID=
# LINE_LOGIN_CHANNEL_ID=
# LINE_LOGIN_CHANNEL_SECRET=
# LINE に登録するコールバック。未設定ならリクエストのホスト + /line/callback。
# LINE_LOGIN_REDIRECT_URL=https://example.com/line/callback
# 案内ページの「LINEで登録・再開する」。上の LINE_OFFICIAL_URL を使う。
# 1 のとき会員管理はトークン入力なしで開く。0 で管理者トークンを要求する。未設定は 1。
# MEMBER_ADMIN_OPEN=1

# 特定商取引法ページ（/legal/tokusho）に出す事業者情報。未設定なら「未設定」と変数名を表示する。
# SELLER_NAME=
# SELLER_ADDRESS=
# SELLER_EMAIL=
# SELLER_TEL=
