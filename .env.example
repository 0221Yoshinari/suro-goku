SITE7_EMAIL=
SITE7_PASSWORD=
SITE7_INPUT_JSON=

# 店舗は config/halls.json で管理（追加・削除はそちらの enabled / 配列を編集）
# 一時的に上書きする場合のみ:
# SITE7_HALL_NAMES=１２３博多店,パーラーゾーン姪浜,玉屋∞本店,プラザ３,プラザ博多

# 1店舗ごとの待機（秒）
SCRAPER_PAUSE_MIN_SEC=2.0
SCRAPER_PAUSE_MAX_SEC=3.0
# 同時セッション。429を避けるため 1
SCRAPER_MAX_WORKERS=1

# ログインセッション（Cookie）の保存先。2回目以降は再ログインしない
# SITE7_STORAGE_STATE=data/site7/.auth/storage_state.json
# SITE7_FORCE_LOGIN=0
# SCRAPER_HEADLESS=1
# CAPTCHA 手動解除の待機秒数（0 なら即失敗）。デバッグ時は 60 など
# SITE7_CAPTCHA_WAIT_SEC=0
# テラモバ2の Turnstile を CapSolver で自動更新する
# CAPSOLVER_API_KEY=
# 古い hallcode URL は使わず、マイホール名で開く（必要なときだけ 1）
# SITE7_USE_HALL_URL=0

# 定期巡回（python3 -m src.scheduler / launchd）
# SCHEDULE_INTERVAL_MIN=30
# SCHEDULE_START=10:50
# SCHEDULE_END=23:00

# レジデンシャルプロキシ（Bright Data / Smartproxy 等）
# 未設定なら直接接続。HOST+PORT か SERVER のどちらかで有効になる。
# 複数本を回すときは config/proxy_config.json の enabled と endpoints を使う。
# 環境変数があるときは、そちらの1本が JSON の一覧より優先される。
# SCRAPER_PROXY_PROTOCOL=http
# SCRAPER_PROXY_HOST=
# SCRAPER_PROXY_PORT=
# SCRAPER_PROXY_USER=
# SCRAPER_PROXY_PASS=
# まとめて書く場合:
# SCRAPER_PROXY_SERVER=http://host:port

# マスターパネル（/master-panel-x7k3q9）は閲覧パスワードに加えてこのトークンが必要。
# 未設定のあいだは管理APIを拒否する。値は画面や通知に出さない。
# MASTER_PANEL_TOKEN=
# MASTER_PANEL_SESSION_HOURS=12

# ダッシュボードの閲覧パスワード。未設定・空のときは 2026
# ログイン後は DASHBOARD_SESSION_DAYS 日間、再入力なしで開ける
# DASHBOARD_PASSWORD=2026
# DASHBOARD_SESSION_DAYS=7
# Cookie署名用。未設定なら閲覧パスワードから派生する
# DASHBOARD_SESSION_SECRET=

# Render 上ではトンネルを使わない。待受ポートは Render が渡す PORT。
# TUNNEL_ENABLED=0
# X_MONITOR_DISABLE=1
# 発行された https://サービス名.onrender.com を、決済後の戻り先にする。
# DASHBOARD_URL=https://サービス名.onrender.com

# ダッシュボードの外部公開（既定で cloudflared のクイックトンネル）
# 起動時と定期巡回の開始時に HTTPS URL を発行し、Discord へリンクを送る
# TUNNEL_ENABLED=1
# TUNNEL_PROVIDER=cloudflared
# 固定の公開URLがあるときだけ設定（未設定ならトンネルURLを使う）
# DASHBOARD_URL=
# ngrok を使う場合: TUNNEL_PROVIDER=ngrok と NGROK_AUTHTOKEN=
# NGROK_AUTHTOKEN=

# LPの申し込みボタンが開く Stripe の決済画面。
# Payment Link（https://buy.stripe.com/...）か Checkout（https://checkout.stripe.com/...）
# STRIPE_PRICE_ID があるときは、サーバが Checkout を作り、決済後 /thanks へ戻す。
# STRIPE_CHECKOUT_URL=
# STRIPE_PRICE_ID=
# サーバだけが使う。画面やフロントのJSには出さない。
# STRIPE_SECRET_KEY=
# Stripe CLI / ダッシュボードの Webhook 署名秘密。/api/stripe/webhook の検証に使う。
# STRIPE_WEBHOOK_SECRET=
# 公開URL。決済後の戻り先になる。未設定なら開いているホスト名を使う。
# DASHBOARD_URL=https://example.com
# Checkout 作成時だけ使う体験日数。Price 側で体験を付けるなら空のままにする。
# STRIPE_TRIAL_DAYS=
# Stripe.js を埋め込まないため、公開可能キーはサーバでは使わない。
# STRIPE_PUBLISHABLE_KEY=
# 1=ライセンスキーだけを受け付け、運営用パスワードでは入れなくする。
# MEMBER_DISABLE_SHARED_PASSWORD=
# 別のブラウザを拒むあいだ（秒）。既定 1200。
# MEMBER_SESSION_IDLE_SEC=1200
# 同じログインのまま、別のIPから同時に開くのを拒む秒数。既定 120。
# MEMBER_CONCURRENT_WINDOW_SEC=120
# 更新Webhookが遅れても、課金中の利用者をすぐ切らない猶予（秒）。体験終了には使わない。
# MEMBER_PERIOD_GRACE_SEC=7200
